# Copy this file to `.env` and fill in the values. `.env` is gitignored — never commit it.
#
# Nothing in this repository should ever read a credential from anywhere but this file.
# No key belongs in source, in a client bundle, or in a chat message.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# DeepSeek is OpenAI-compatible. Get a key at https://platform.deepseek.com
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# deepseek-v4-flash  — cheap and fast. Default for extraction and summarisation.
# deepseek-v4-pro    — stronger reasoning, ~3x the cost. Use only where it earns it.
# The older deepseek-chat / deepseek-reasoner aliases were retired in July 2026.
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_REASONING=deepseek-v4-pro

# ---------------------------------------------------------------------------
# WhatsApp Business Platform (Cloud API)
# ---------------------------------------------------------------------------
# All five come from the Meta App Dashboard. See docs/whatsapp-setup.md.

# WhatsApp > API Setup > "Phone number ID" (a number, NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp > API Setup > "WhatsApp Business Account ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=

# A system user token from Business Settings. The 24-hour token on the API Setup
# page is for the first curl only — it will expire mid-demo.
WHATSAPP_ACCESS_TOKEN=

# App Dashboard > App Settings > Basic > "App Secret".
# Used to verify the signature on every inbound webhook. Without it, anyone who
# learns your callback URL can inject fake patient messages into the system.
WHATSAPP_APP_SECRET=

# A random string you invent. You type it into Meta's webhook configuration form
# and Meta echoes it back during the verification handshake.
#   openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=

# Meta's Graph API version. Pin it — unpinned, your parsing breaks on their schedule.
WHATSAPP_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
